# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# META FOR DEVELOPERS / FACEBOOK GRAPH API
# -----------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Token dài hạn từ System User trong Meta Business Manager (Khuyến nghị)
META_SYSTEM_USER_TOKEN=your-meta-system-user-access-token

# -----------------------------------------------------------------------------
# VERCEL CRON SECURITY
# -----------------------------------------------------------------------------
# Dùng chuỗi ngẫu nhiên bảo mật để ngăn chặn kích hoạt cron trái phép từ ngoài
CRON_SECRET=your-secure-random-cron-secret-key
